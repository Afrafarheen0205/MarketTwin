# MarketTwin Frontend Environment Configuration

# Backend API Base URL
# Leave empty during local development to use the Vite /api proxy.
# Set to the deployed backend URL for production builds.
VITE_API_BASE_URL=

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# Note: The anon key is safe for client-side use when Row-Level Security (RLS) is enabled.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
